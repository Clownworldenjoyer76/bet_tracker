DJANGO_SETTINGS_MODULE=config.production
DJANGO_STRICT_PRODUCTION_CONFIG=true

# Generate a production-only secret. Never commit the real value.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

DB_ENGINE=postgresql
DB_NAME=bet_tracker
DB_USER=bet_tracker
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# Set true only when requests reach Django through a trusted reverse proxy
# that sets X-Forwarded-Proto correctly.
DJANGO_TRUST_PROXY_SSL_HEADER=false

DJANGO_SECURE_SSL_REDIRECT=true

# Stage HSTS after HTTPS is verified end-to-end. Start small, then increase.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

DJANGO_LOG_LEVEL=INFO
WHITENOISE_MAX_AGE=31536000

# Password-reset email should use a real provider in production.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Edgelytics <no-reply@example.com>
SERVER_EMAIL=Edgelytics <server@example.com>

# Stripe code is installed, but account configuration is intentionally shelved.
# Leave blank until the separate Stripe test-mode handoff is resumed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=

# Application server tuning. Start conservatively and tune from measurements.
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
